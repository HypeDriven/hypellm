# Hard ceilings. A configuration may lower these, never raise them past.
MAX_BODY_CEILING = 256 * 1024 * 1024
MAX_PART_CEILING = 16 * 1024 * 1024 * 1024
MAX_CONNECTIONS_CEILING = 256
MAX_RETAINED_JOBS = 64
MAX_CONFIG_BYTES = 256 * 1024
MAX_INPUTS = 4
MAX_PARTS = 4
MAX_PROMPT_BYTES = 64 * 1024
READ_CHUNK = 64 * 1024

IDENTIFIER = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
FILE_NAME = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$")
PLACEHOLDER = re.compile(r"\{([a-z_]+)(?::([A-Za-z0-9_-]{1,64}))?\}")

STATES = ("queued", "running", "succeeded", "failed", "cancelled")
ERRORS = ("invalid_input", "out_of_memory", "not_ready", "internal")
MEDIA_TYPES = {
    "audio/flac": "flac",
    "audio/wav": "wav",
    "video/mp4": "mp4",
    "image/png": "png",
    "image/webp": "webp",
    "model/gltf-binary": "glb",
    "application/octet-stream": "bin",
}
PARAMS = ("duration_ms", "seed", "steps", "width", "height", "count")
SUBMIT_FIELDS = ("verb", "prompt", "params", "inputs", "options", "request_id")

# The exit codes a command signals with (sysexits.h).
EX_DATAERR = 65
EX_TEMPFAIL = 75


class Refusal(Exception):
    """A request this shim declines: the HTTP status and the protocol error."""

    def __init__(self, status: int, error: str) -> None:
        if error not in ERRORS:
            error = "internal"
        super().__init__(error)
        self.status = status
        self.error = error


# --------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------


@dataclass(frozen=True)
class Part:
    name: str
    file: str
    media_type: str
    optional: bool = False


@dataclass(frozen=True)
class Verb:
    name: str
    argv: tuple[str, ...]
    inputs: dict[str, tuple[str, ...]]
    parts: tuple[Part, ...]
    timeout_s: int
    progress_file: str | None = None
    optional_inputs: frozenset[str] = frozenset()


@dataclass(frozen=True)
class Config:
    host: str
    port: int
    key: bytes
    work_dir: str
    verbs: dict[str, Verb]
    max_body_bytes: int = 64 * 1024 * 1024
    max_part_bytes: int = 1024 * 1024 * 1024
    max_connections: int = 16
    retention_s: int = 900


class ConfigError(Exception):
    pass


def bounded_int(document: dict[str, Any], key: str, default: int, low: int, high: int) -> int:
    value = document.get(key, default)
    if not isinstance(value, int) or isinstance(value, bool) or not low <= value <= high:
        raise ConfigError(f"{key} must be an integer from {low} to {high}")
    return value


def load_verb(name: str, document: Any) -> Verb:
    if not isinstance(document, dict):
        raise ConfigError(f"verb {name}: must be an object")
    unknown = set(document) - {"argv", "inputs", "parts", "timeout_s", "progress_file"}
    if unknown:
        raise ConfigError(f"verb {name}: unknown fields {sorted(unknown)}")
    argv = document.get("argv")
    if (
        not isinstance(argv, list)
        or not argv
        or not all(isinstance(a, str) for a in argv)
        or not os.path.isabs(argv[0])
    ):
        raise ConfigError(f"verb {name}: argv must be a list of strings starting with an absolute program")
    inputs_document = document.get("inputs", {})
    if not isinstance(inputs_document, dict) or len(inputs_document) > MAX_INPUTS:
        raise ConfigError(f"verb {name}: inputs must be an object of at most {MAX_INPUTS}")
    inputs: dict[str, tuple[str, ...]] = {}
    optional_inputs: set[str] = set()
    for input_name, declared in inputs_document.items():
        if not IDENTIFIER.match(input_name):
            raise ConfigError(f"verb {name}: input name {input_name!r} is not an identifier")
        # A list of media types is a required input; an object can make one
        # optional. An optional input has no placeholder: there is no whole
        # value to put in its place when it is absent, so the command finds it
        # at in/<name>.<ext> in its working directory, or does not.
        types = declared
        if isinstance(declared, dict):
            if set(declared) - {"media_types", "optional"} or not isinstance(declared.get("optional", False), bool):
                raise ConfigError(f"verb {name}: input {input_name} has unknown fields")
            types = declared.get("media_types")
            if declared.get("optional", False):
                optional_inputs.add(input_name)
        if not isinstance(types, list) or not types or not all(t in MEDIA_TYPES for t in types):
            raise ConfigError(f"verb {name}: input {input_name} must list media types from the protocol's set")
        inputs[input_name] = tuple(types)
    parts_document = document.get("parts")
    if not isinstance(parts_document, dict) or not 1 <= len(parts_document) <= MAX_PARTS:
        raise ConfigError(f"verb {name}: parts must be an object of 1 to {MAX_PARTS}")
    parts = []
    files: set[str] = set()
    for part_name, part in parts_document.items():
        if not IDENTIFIER.match(part_name) or not isinstance(part, dict):
            raise ConfigError(f"verb {name}: part {part_name!r} is not an identifier with an object")
        file = part.get("file")
        media_type = part.get("media_type")
        optional = part.get("optional", False)
        if not isinstance(file, str) or not FILE_NAME.match(file) or file in (".", ".."):
            raise ConfigError(f"verb {name}: part {part_name}'s file must be a plain file name")
        if file in files:
            raise ConfigError(f"verb {name}: two parts share the file {file}")
        files.add(file)
        if media_type not in MEDIA_TYPES:
            raise ConfigError(f"verb {name}: part {part_name}'s media type is not in the protocol's set")
        if not isinstance(optional, bool) or set(part) - {"file", "media_type", "optional"}:
            raise ConfigError(f"verb {name}: part {part_name} has unknown fields")
        parts.append(Part(part_name, file, media_type, optional))
    if all(p.optional for p in parts):
        raise ConfigError(f"verb {name}: at least one part must be required")
    for element in argv:
        for match in PLACEHOLDER.finditer(element):
            kind, arg = match.group(1), match.group(2)
            if kind == "input":
                if arg not in inputs:
                    raise ConfigError(f"verb {name}: argv names undeclared input {arg!r}")
                if arg in optional_inputs:
                    raise ConfigError(f"verb {name}: optional input {arg!r} cannot be a placeholder")
            elif kind in ("prompt", "params_file", "options_file", "out_dir") and arg is None:
                pass
            else:
                raise ConfigError(f"verb {name}: argv has unknown placeholder {match.group(0)}")
    progress_file = document.get("progress_file")
    if progress_file is not None and (not isinstance(progress_file, str) or not FILE_NAME.match(progress_file)):
        raise ConfigError(f"verb {name}: progress_file must be a plain file name")
    timeout_s = bounded_int(document, "timeout_s", 900, 1, 86_400)
    return Verb(name, tuple(argv), inputs, tuple(parts), timeout_s, progress_file, frozenset(optional_inputs))


def load_config(path: str) -> Config:
    with open(path, "rb") as handle:
        raw = handle.read(MAX_CONFIG_BYTES + 1)
    if len(raw) > MAX_CONFIG_BYTES:
        raise ConfigError("configuration is too large")
    document = json.loads(raw)
    if not isinstance(document, dict):
        raise ConfigError("configuration must be an object")
    unknown = set(document) - {
        "listen", "key_file", "work_dir", "verbs", "max_body_bytes",
        "max_part_bytes", "max_connections", "retention_s",
    }
    if unknown:
        raise ConfigError(f"unknown fields {sorted(unknown)}")
    listen = document.get("listen")
    if not isinstance(listen, str) or ":" not in listen:
        raise ConfigError("listen must be host:port")
    host, _, port_text = listen.rpartition(":")
    if not port_text.isdigit() or not 0 <= int(port_text) <= 65535:
        raise ConfigError("listen port is out of range")
    key_file = document.get("key_file")
    if not isinstance(key_file, str):
        raise ConfigError("key_file is required")
    key = read_key(key_file)
    work_dir = document.get("work_dir")
    if not isinstance(work_dir, str) or not os.path.isabs(work_dir):
        raise ConfigError("work_dir must be an absolute path")
    verbs_document = document.get("verbs")
    if not isinstance(verbs_document, dict) or not verbs_document:
        raise ConfigError("verbs must declare at least one verb")
    verbs = {name: load_verb(name, verb) for name, verb in verbs_document.items()}
    return Config(
        host=host.strip("[]"),
        port=int(port_text),
        key=key,
        work_dir=work_dir,
        verbs=verbs,
        max_body_bytes=bounded_int(document, "max_body_bytes", 64 * 1024 * 1024, 1024, MAX_BODY_CEILING),
        max_part_bytes=bounded_int(document, "max_part_bytes", 1024 * 1024 * 1024, 1, MAX_PART_CEILING),
        max_connections=bounded_int(document, "max_connections", 16, 1, MAX_CONNECTIONS_CEILING),
        retention_s=bounded_int(document, "retention_s", 900, 1, 86_400),
    )


def read_key(path: str) -> bytes:
    """The bearer the router presents: visible ASCII, at least 16 bytes."""
    info = os.stat(path)
    if info.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        raise ConfigError(f"{path} must not be readable by group or others")
    with open(path, "rb") as handle:
        key = handle.read(4097).strip()
    if not 16 <= len(key) <= 4096 or not all(0x21 <= b <= 0x7E for b in key):
        raise ConfigError("the key must be 16 to 4096 visible ASCII characters")
    return key


