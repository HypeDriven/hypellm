# Jobs
# --------------------------------------------------------------------------


@dataclass
class Job:
    id: str
    verb: Verb
    directory: str
    started: float
    state: str = "running"
    error: str | None = None
    parts: list[tuple[Part, int]] = field(default_factory=list)
    process: subprocess.Popen[bytes] | None = None
    finished: float | None = None
    cancelled: bool = False


class Jobs:
    """The job table: one job running at a time, a bounded number retained."""

    def __init__(self, config: Config, log: Log) -> None:
        self.config = config
        self.log = log
        self.lock = threading.Lock()
        self.jobs: dict[str, Job] = {}

    def sweep_locked(self) -> None:
        now = time.monotonic()
        for job_id in [
            j.id for j in self.jobs.values()
            if j.finished is not None and now - j.finished > self.config.retention_s
        ]:
            job = self.jobs.pop(job_id)
            shutil.rmtree(job.directory, ignore_errors=True)

    def submit(self, document: Any) -> str:
        verb, prompt, params, inputs, options = validate_submit(document, self.config)
        with self.lock:
            self.sweep_locked()
            if any(j.state == "running" for j in self.jobs.values()):
                raise Refusal(503, "not_ready")
            if len(self.jobs) >= MAX_RETAINED_JOBS:
                raise Refusal(503, "not_ready")
            job_id = "j" + secrets.token_hex(12)
            directory = os.path.join(self.config.work_dir, job_id)
            os.makedirs(os.path.join(directory, "in"), mode=0o700)
            os.makedirs(os.path.join(directory, "out"), mode=0o700)
            job = Job(job_id, verb, directory, time.monotonic())
            self.jobs[job_id] = job
        try:
            argv = render_argv(verb, directory, prompt, params, inputs, options)
            # The command's output goes to the job's own log, which is removed
            # with the job; the shim's log never carries it.
            with open(os.path.join(directory, "log"), "wb") as output:
                job.process = subprocess.Popen(
                    argv,
                    cwd=directory,
                    stdin=subprocess.DEVNULL,
                    stdout=output,
                    stderr=subprocess.STDOUT,
                    env={"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": directory, "LANG": "C.UTF-8"},
                    start_new_session=True,
                    close_fds=True,
                )
        except OSError:
            with self.lock:
                self.finish_locked(job, "failed", "internal")
            return job_id
        threading.Thread(target=self.watch, args=(job,), daemon=True).start()
        return job_id

    def watch(self, job: Job) -> None:
        process = job.process
        if process is None:
            return
        try:
            code = process.wait(timeout=job.verb.timeout_s)
        except subprocess.TimeoutExpired:
            kill(process)
            code = None
        with self.lock:
            if job.cancelled:
                self.finish_locked(job, "cancelled", None)
            elif code == 0:
                parts = collect_parts(job, self.config)
                if parts is None:
                    self.finish_locked(job, "failed", "internal")
                else:
                    job.parts = parts
                    self.finish_locked(job, "succeeded", None)
            elif code == EX_DATAERR:
                self.finish_locked(job, "failed", "invalid_input")
            elif code == EX_TEMPFAIL:
                self.finish_locked(job, "failed", "out_of_memory")
            else:
                self.finish_locked(job, "failed", "internal")

    def finish_locked(self, job: Job, state: str, error: str | None) -> None:
        job.state = state
        job.error = error
        job.finished = time.monotonic()
        if state != "succeeded":
            # Nothing of a failed or cancelled job will be served, so nothing
            # of it is kept.
            shutil.rmtree(job.directory, ignore_errors=True)

    def status(self, job_id: str) -> dict[str, Any]:
        with self.lock:
            self.sweep_locked()
            job = self.jobs.get(job_id)
            if job is None:
                raise Refusal(404, "invalid_input")
            elapsed = int(((job.finished or time.monotonic()) - job.started) * 1000)
            body: dict[str, Any] = {"state": job.state, "elapsed_ms": elapsed}
            if job.state == "running":
                body["progress_permille"] = read_progress(job)
            elif job.state == "succeeded":
                body["progress_permille"] = 1000
                body["parts"] = [
                    {"name": p.name, "media_type": p.media_type, "bytes": size}
                    for p, size in job.parts
                ]
            if job.state == "failed":
                body["error"] = job.error or "internal"
            return body

    def part(self, job_id: str, name: str) -> tuple[str, str, int]:
        with self.lock:
            job = self.jobs.get(job_id)
            if job is None or job.state != "succeeded":
                raise Refusal(404, "invalid_input")
            for part, size in job.parts:
                if part.name == name:
                    return os.path.join(job.directory, "out", part.file), part.media_type, size
        raise Refusal(404, "invalid_input")

    def cancel(self, job_id: str) -> bool:
        with self.lock:
            job = self.jobs.get(job_id)
            if job is None:
                raise Refusal(404, "invalid_input")
            if job.state != "running":
                return False
            job.cancelled = True
            process = job.process
        if process is not None:
            kill(process)
        return True


def kill(process: subprocess.Popen[bytes]) -> None:
    """Stop a command and everything it started: its whole session."""
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(process.pid, sig)
        except (ProcessLookupError, PermissionError):
            return
        try:
            process.wait(timeout=5)
            return
        except subprocess.TimeoutExpired:
            continue


def read_progress(job: Job) -> int:
    """The command's own progress, if it writes one: clamped below 1000, since
    a job is not done until it has exited."""
    if job.verb.progress_file is None:
        return 0
    try:
        with open(os.path.join(job.directory, "out", job.verb.progress_file), "rb") as handle:
            text = handle.read(16).strip()
        return max(0, min(999, int(text)))
    except (OSError, ValueError):
        return 0


def collect_parts(job: Job, config: Config) -> list[tuple[Part, int]] | None:
    """Each declared output: a regular file, not a link, within the cap."""
    out = os.path.join(job.directory, "out")
    parts: list[tuple[Part, int]] = []
    for part in job.verb.parts:
        path = os.path.join(out, part.file)
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            if part.optional:
                continue
            return None
        if not stat.S_ISREG(info.st_mode) or info.st_size > config.max_part_bytes:
            return None
        parts.append((part, info.st_size))
    return parts or None


def validate_submit(document: Any, config: Config) -> tuple[Verb, str, dict[str, int], dict[str, tuple[str, bytes]], Any]:
    if not isinstance(document, dict) or set(document) - set(SUBMIT_FIELDS):
        raise Refusal(400, "invalid_input")
    verb = config.verbs.get(document.get("verb"))  # type: ignore[arg-type]
    if verb is None:
        raise Refusal(400, "invalid_input")
    prompt = document.get("prompt", "")
    if not isinstance(prompt, str) or len(prompt.encode()) > MAX_PROMPT_BYTES or "\0" in prompt:
        raise Refusal(400, "invalid_input")
    params_document = document.get("params", {})
    if not isinstance(params_document, dict) or set(params_document) - set(PARAMS):
        raise Refusal(400, "invalid_input")
    params: dict[str, int] = {}
    for key, value in params_document.items():
        if not isinstance(value, int) or isinstance(value, bool) or value < 0:
            raise Refusal(400, "invalid_input")
        params[key] = value
    inputs_document = document.get("inputs", [])
    if not isinstance(inputs_document, list) or len(inputs_document) > MAX_INPUTS:
        raise Refusal(400, "invalid_input")
    inputs: dict[str, tuple[str, bytes]] = {}
    for item in inputs_document:
        if not isinstance(item, dict) or set(item) != {"name", "media_type", "data"}:
            raise Refusal(400, "invalid_input")
        name, media_type, data = item["name"], item["media_type"], item["data"]
        if not isinstance(name, str) or not IDENTIFIER.match(name) or name in inputs:
            raise Refusal(400, "invalid_input")
        if name not in verb.inputs or media_type not in verb.inputs[name]:
            raise Refusal(400, "invalid_input")
        if not isinstance(data, str):
            raise Refusal(400, "invalid_input")
        try:
            raw = base64.b64decode(data, validate=True)
        except (binascii.Error, ValueError) as error:
            raise Refusal(400, "invalid_input") from error
        inputs[name] = (media_type, raw)
    if set(verb.inputs) - verb.optional_inputs - set(inputs):
        raise Refusal(400, "invalid_input")
    options = document.get("options")
    if options is not None and not isinstance(options, dict):
        raise Refusal(400, "invalid_input")
    request_id = document.get("request_id", "")
    if not isinstance(request_id, str) or len(request_id) > 64:
        raise Refusal(400, "invalid_input")
    return verb, prompt, params, inputs, options


def render_argv(
    verb: Verb,
    directory: str,
    prompt: str,
    params: dict[str, int],
    inputs: dict[str, tuple[str, bytes]],
    options: Any,
) -> list[str]:
    """Write the job's files and build its argv: no shell, whole values."""
    files: dict[str, str] = {}
    for name, (media_type, raw) in inputs.items():
        path = os.path.join(directory, "in", f"{name}.{MEDIA_TYPES[media_type]}")
        write_private(path, raw)
        files[f"input:{name}"] = path
    params_file = os.path.join(directory, "params.json")
    write_private(params_file, json.dumps(params).encode())
    options_file = os.path.join(directory, "options.json")
    write_private(options_file, json.dumps(options or {}).encode())
    values = {
        "prompt": prompt,
        "params_file": params_file,
        "options_file": options_file,
        "out_dir": os.path.join(directory, "out"),
        **files,
    }

    def substitute(match: re.Match[str]) -> str:
        key = match.group(1) if match.group(2) is None else f"{match.group(1)}:{match.group(2)}"
        return values[key]

    return [PLACEHOLDER.sub(substitute, element) for element in verb.argv]


def write_private(path: str, data: bytes) -> None:
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(data)


# --------------------------------------------------------------------------
# HTTP
# --------------------------------------------------------------------------


class Log:
    def __init__(self, stream: Any = sys.stderr) -> None:
        self.stream = stream
        self.lock = threading.Lock()

    def line(self, **fields: Any) -> None:
        text = " ".join(f"{k}={v}" for k, v in fields.items())
        with self.lock:
            print(text, file=self.stream, flush=True)


def no_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    keys = [k for k, _ in pairs]
    if len(set(keys)) != len(keys):
        raise ValueError("duplicate key")
    return dict(pairs)


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "hypellm-job-shim"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    # Set by the server.
    shim: Shim

    def log_message(self, format: str, *args: Any) -> None:  # noqa: A002
        # The standard log would print the request line, which carries a job
        # id but never a body; the shim logs its own shorter line instead.
        pass

    def reply(self, status: int, body: dict[str, Any]) -> None:
        payload = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(payload)
        self.close_connection = True

    def route(self) -> str:
        parts = self.path.split("/")
        if len(parts) >= 5 and parts[:4] == ["", "job", "v1", "jobs"]:
            return "/job/v1/jobs/{id}" + ("/parts/{name}" if len(parts) == 7 else "")
        return self.path if self.path in ("/job/v1/health", "/job/v1/jobs") else "other"

    def authenticated(self) -> bool:
        header = self.headers.get("Authorization", "")
        if not header.startswith("Bearer "):
            return False
        return hmac.compare_digest(header[len("Bearer "):].encode(), self.shim.config.key)

    def body(self) -> Any:
        if self.headers.get("Transfer-Encoding") is not None:
            raise Refusal(411, "invalid_input")
        length_text = self.headers.get("Content-Length", "0")
        if not length_text.isdigit():
            raise Refusal(400, "invalid_input")
        length = int(length_text)
        if length > self.shim.config.max_body_bytes:
            raise Refusal(413, "invalid_input")
        raw = self.rfile.read(length)
        try:
            return json.loads(raw, object_pairs_hook=no_duplicates)
        except (ValueError, RecursionError) as error:
            raise Refusal(400, "invalid_input") from error

    def handle_any(self, method: str) -> None:
        status = 500
        try:
            if not self.authenticated():
                status = 401
                self.reply(401, {"error": "invalid_input"})
                return
            status = self.dispatch(method)
        except Refusal as refusal:
            status = refusal.status
            self.reply(refusal.status, {"error": refusal.error})
        except Exception:  # noqa: BLE001
            status = 500
            self.reply(500, {"error": "internal"})
        finally:
            self.shim.log.line(method=method, route=self.route(), status=status)

    def path_parts(self) -> list[str]:
        parts = self.path.split("/")
        for segment in parts[4:]:
            if not IDENTIFIER.match(segment) and segment != "parts":
                raise Refusal(404, "invalid_input")
        return parts

    def dispatch(self, method: str) -> int:
        jobs = self.shim.jobs
        if method == "GET" and self.path == "/job/v1/health":
            self.reply(200, {"verbs": sorted(self.shim.config.verbs)})
            return 200
        if method == "POST" and self.path == "/job/v1/jobs":
            job_id = jobs.submit(self.body())
            self.reply(202, {"id": job_id})
            return 202
        parts = self.path_parts()
        if len(parts) == 5 and parts[:4] == ["", "job", "v1", "jobs"]:
            if method == "GET":
                self.reply(200, jobs.status(parts[4]))
                return 200
            if method == "DELETE":
                self.reply(202, {"stopped": jobs.cancel(parts[4])})
                return 202
        if method == "GET" and len(parts) == 7 and parts[:4] == ["", "job", "v1", "jobs"] and parts[5] == "parts":
            path, media_type, size = jobs.part(parts[4], parts[6])
            self.send_response(200)
            self.send_header("Content-Type", media_type)
            self.send_header("Content-Length", str(size))
            self.send_header("Connection", "close")
            self.end_headers()
            with open(path, "rb") as handle:
                remaining = size
                while remaining > 0:
                    chunk = handle.read(min(READ_CHUNK, remaining))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    remaining -= len(chunk)
            self.close_connection = True
            return 200
        raise Refusal(404, "invalid_input")

    def do_GET(self) -> None:  # noqa: N802
        self.handle_any("GET")

    def do_POST(self) -> None:  # noqa: N802
        self.handle_any("POST")

    def do_DELETE(self) -> None:  # noqa: N802
        self.handle_any("DELETE")


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, shim: Shim) -> None:
        self.shim = shim
        self.slots = threading.BoundedSemaphore(shim.config.max_connections)
        handler = type("BoundHandler", (Handler,), {"shim": shim})
        super().__init__((shim.config.host, shim.config.port), handler)

    def process_request(self, request: Any, client_address: Any) -> None:
        # Bounded: past max_connections a connection is closed, not queued.
        if not self.slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        super().process_request(request, client_address)

    def process_request_thread(self, request: Any, client_address: Any) -> None:
        try:
            super().process_request_thread(request, client_address)
        finally:
            self.slots.release()


class Shim:
    def __init__(self, config: Config, log: Log | None = None) -> None:
        self.config = config
        self.log = log or Log()
        os.makedirs(config.work_dir, mode=0o700, exist_ok=True)
        # Jobs are not durable: what a previous process left can be served by
        # nobody, so it goes.
        for entry in os.listdir(config.work_dir):
            if re.match(r"^j[0-9a-f]{24}$", entry):
                shutil.rmtree(os.path.join(config.work_dir, entry), ignore_errors=True)
        self.jobs = Jobs(config, self.log)
        self.server = Server(self)
        self.serving = threading.Event()

    @property
    def address(self) -> tuple[str, int]:
        return self.server.server_address[:2]  # type: ignore[return-value]

    def serve(self) -> None:
        self.serving.set()
        self.server.serve_forever(poll_interval=0.2)

    def close(self) -> None:
        # `shutdown` waits for `serve_forever` to notice, so it is only asked
        # of a server that is serving; one that never started would wait for
        # ever.
        if self.serving.is_set():
            self.server.shutdown()
        self.server.server_close()
        for job in list(self.jobs.jobs.values()):
            if job.process is not None and job.state == "running":
                kill(job.process)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--config", required=True)
    args = parser.parse_args(argv)
    for name in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY"):
        if name in os.environ:
            print(f"{name} is set and ignored: this shim makes no outbound requests", file=sys.stderr)
    try:
        config = load_config(args.config)
    except (OSError, ValueError, ConfigError) as error:
        print(f"configuration refused: {error}", file=sys.stderr)
        return 2
    shim = Shim(config)
    print(f"listening on {config.host}:{config.port}", file=sys.stderr, flush=True)
    try:
        shim.serve()
    except KeyboardInterrupt:
        pass
    finally:
        shim.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
