#!/usr/bin/env python3
"""End-to-end acceptance for the HypeLLM identity verifier.

`--selftest` covers the verifier's JOSE logic in-process, and
`crates/hypellm-net/tests/fuzz.rs` covers the router's client against a scripted
socket. Neither proves the two agree on the wire. This does, against the real
process, with a real HTTPS key-set fetch and a real OpenSSL signature check.

It runs two layers:

1. **The wire, re-derived.** A client written here speaks the router's framing
   byte for byte, as `crates/hypellm-net/src/helper.rs` writes it. Deliberately
   a second implementation: the point is to disagree if the framing is wrong.
2. **The router's actual client.** `cargo test -p hypellm-net --test
   verifier_acceptance -- --ignored`, with the socket path and fixtures in the
   environment. Those tests are `#[ignore]`d because standing this process up
   means running one, which specification 4.1 forbids the router from doing —
   so the harness starts it and the tests only connect.

Nothing here touches the network. The key set is served from a local TLS server
whose certificate the verifier is told to trust through `SSL_CERT_FILE`, which
exercises the real HTTPS path rather than bypassing it.

    verifier/acceptance             both layers
    verifier/acceptance --no-cargo  the wire only, for a machine with no Rust
"""

from __future__ import annotations

import argparse
import base64
import contextlib
import http.server
import json
import os
import shutil
import socket
import ssl
import subprocess
import sys
import tempfile
import threading
import time

ISSUER = "https://accounts.google.com"
CLIENT_ID = "acceptance.apps.googleusercontent.com"
REDIRECT_URI = "https://admin.example/admin/v1/auth/google/callback"
SUBJECT = "104729183746152938471"
EMAIL = "operator@example.com"
KID = "acceptance-1"

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)

passed: list[str] = []
failed: list[str] = []


def check(name: str, condition: bool) -> None:
    (passed if condition else failed).append(name)
    print(f"  {'ok   ' if condition else 'FAIL '} {name}")


def b64u(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")


def run(command: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(
        command, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kwargs
    )


# -- Fixtures -----------------------------------------------------------------


class Fixtures:
    """A signing key, a key set that publishes it, and a TLS server for it."""

    def __init__(self, workspace: str) -> None:
        self.workspace = workspace
        self.signing = os.path.join(workspace, "signing.pem")
        self.unpublished = os.path.join(workspace, "unpublished.pem")
        for path in (self.signing, self.unpublished):
            run(["openssl", "genrsa", "-out", path, "2048"])

        # Only `signing` is published, so a token from `unpublished` is a token
        # whose `kid` the issuer does not know — a real rotation failure, and
        # distinct from a tampered signature.
        keys = {"keys": [self._jwk(self.signing, KID)]}
        self.jwks_path = os.path.join(workspace, "certs.json")
        with open(self.jwks_path, "w", encoding="utf-8") as handle:
            json.dump(keys, handle)

        self.certificate = os.path.join(workspace, "server.crt")
        key = os.path.join(workspace, "server.key")
        run([
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", key, "-out", self.certificate, "-days", "1",
            "-subj", "/CN=localhost", "-addext", "subjectAltName=DNS:localhost",
        ])
        self.port = self._serve(self.certificate, key)

    def _jwk(self, key_path: str, kid: str) -> dict:
        modulus = (
            run(["openssl", "rsa", "-in", key_path, "-noout", "-modulus"])
            .stdout.decode("ascii")
            .split("=", 1)[1]
            .strip()
        )
        return {
            "kty": "RSA",
            "use": "sig",
            "alg": "RS256",
            "kid": kid,
            "n": b64u(bytes.fromhex(modulus)),
            # `openssl genrsa` uses F4. Read back rather than assumed would be
            # better; if it ever changes, the positive case fails loudly.
            "e": b64u((65537).to_bytes(3, "big")),
        }

    def _serve(self, certificate: str, key: str) -> int:
        jwks_path = self.jwks_path

        class Handler(http.server.BaseHTTPRequestHandler):
            def do_GET(self) -> None:  # noqa: N802 - the stdlib's spelling
                with open(jwks_path, "rb") as handle:
                    body = handle.read()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

            def log_message(self, *_args) -> None:
                pass

        server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.load_cert_chain(certificate, key)
        server.socket = context.wrap_socket(server.socket, server_side=True)
        self.server = server
        threading.Thread(target=server.serve_forever, daemon=True).start()
        return server.socket.getsockname()[1]

    def token(self, claims: dict, key_path: str | None = None, kid: str = KID) -> str:
        header = {"alg": "RS256", "kid": kid, "typ": "JWT"}
        signing_input = f"{b64u(json.dumps(header).encode())}.{b64u(json.dumps(claims).encode())}"
        data = os.path.join(self.workspace, "signing-input.bin")
        with open(data, "wb") as handle:
            handle.write(signing_input.encode("ascii"))
        signature = run(
            ["openssl", "dgst", "-sha256", "-sign", key_path or self.signing, data]
        ).stdout
        return f"{signing_input}.{b64u(signature)}"

    def claims(self) -> dict:
        return {
            "iss": ISSUER,
            "sub": SUBJECT,
            "aud": CLIENT_ID,
            "azp": CLIENT_ID,
            "exp": 4102444800,
            "iat": 1700000000,
            "nonce": "n-0S6_WzA2Mj",
            "email": EMAIL,
            "email_verified": True,
            "hd": "example.com",
            "name": "Alice",
        }


# -- The router's framing, re-derived ----------------------------------------


def router_request(socket_path: str, verb: str, payload: str) -> tuple[str, dict | None]:
    """Exactly what `VerifierClient::request` writes, and how it reads the reply."""
    stream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    stream.settimeout(30)
    try:
        stream.connect(socket_path)
        stream.sendall(f"{verb} {len(payload)}\n".encode("ascii") + payload.encode("utf-8"))

        line = b""
        while b"\n" not in line:
            chunk = stream.recv(1)
            if not chunk:
                return ("<closed>", None)
            line += chunk
            if len(line) > 256:
                return ("<overlong status line>", None)

        status, _, rest = line.partition(b"\n")
        text = status.decode("ascii", "replace")
        if text.startswith("ERR "):
            return (text[4:], None)
        if not text.startswith("OK "):
            return ("<protocol violation>", None)

        length = int(text[3:])
        body = rest
        while len(body) < length:
            chunk = stream.recv(length - len(body))
            if not chunk:
                return ("<short body>", None)
            body += chunk
        return ("OK", json.loads(body.decode("utf-8")))
    finally:
        stream.close()


# -- The run ------------------------------------------------------------------


def wire_layer(socket_path: str, fixtures: Fixtures) -> dict[str, str]:
    """Check the framing, and return the fixtures the Rust layer needs."""
    claims = fixtures.claims()
    good = fixtures.token(claims)

    code, body = router_request(socket_path, "VERIFY", good)
    check("a signed token verifies over the router's framing", code == "OK")
    check("the subject survives the round trip", bool(body) and body.get("sub") == SUBJECT)
    check(
        "every claim parse_claims reads is present",
        body is not None
        and all(
            field in body
            for field in ("iss", "sub", "aud", "exp", "iat", "nonce", "email", "email_verified", "hd")
        ),
    )
    check(
        "the verifier does not judge the claims it returns",
        # An expired token must come back verified: `validate_claims` is the one
        # place `exp` is judged (verifier/README.md, rule 4). A verifier that
        # helpfully refused it here would create the second path.
        router_request(socket_path, "VERIFY", fixtures.token(dict(claims, exp=1)))[0] == "OK",
    )

    # The signature covers the token's own bytes, so re-encoding the payload
    # after signing must not verify — the header and signature are kept exactly
    # as they were and only the claims are swapped.
    header_segment, _, remainder = good.partition(".")
    signature_segment = remainder.rsplit(".", 1)[1]
    tampered_payload = b64u(json.dumps(dict(claims, sub="000000000000")).encode())
    tampered = f"{header_segment}.{tampered_payload}.{signature_segment}"
    code, _ = router_request(socket_path, "VERIFY", tampered)
    check("a payload swapped after signing is refused", code == "signature_invalid")

    unknown = fixtures.token(claims, key_path=fixtures.unpublished)
    code, _ = router_request(socket_path, "VERIFY", unknown)
    check("a token signed by an unpublished key is refused", code == "signature_invalid")

    rotated = fixtures.token(claims, kid="rotated-away")
    code, _ = router_request(socket_path, "VERIFY", rotated)
    check("an unknown kid is refused", code == "unknown_kid")

    code, _ = router_request(socket_path, "VERIFY", "not.a.token")
    check("a malformed token is refused", code == "malformed")

    code, _ = router_request(socket_path, "NONSENSE", "x")
    check("an unknown verb is refused", code == "unknown_verb")

    code, _ = router_request(
        socket_path,
        "EXCHANGE",
        json.dumps({
            "code": "c",
            "code_verifier": "v",
            "token_endpoint": "https://tokens.evil.example/token",
            "client_id": CLIENT_ID,
            "redirect_uri": REDIRECT_URI,
        }),
    )
    check("an exchange redirected off the configured endpoint is refused", code == "endpoint_mismatch")

    mode = os.stat(socket_path).st_mode
    check(f"the socket is not world-accessible ({oct(mode & 0o777)})", (mode & 0o007) == 0)

    return {
        "HYPELLM_VERIFIER_SOCKET": socket_path,
        "HYPELLM_VERIFIER_TOKEN": good,
        "HYPELLM_VERIFIER_TAMPERED": tampered,
        "HYPELLM_VERIFIER_UNKNOWN_KID": unknown,
        "HYPELLM_VERIFIER_EXPECT_ISS": ISSUER,
        "HYPELLM_VERIFIER_EXPECT_SUB": SUBJECT,
        "HYPELLM_VERIFIER_EXPECT_AUD": CLIENT_ID,
        "HYPELLM_VERIFIER_EXPECT_EMAIL": EMAIL,
    }


def cargo_layer(environment: dict[str, str]) -> None:
    """Run the router's own client against the process now listening."""
    if shutil.which("cargo") is None:
        check("cargo is available for the client layer (skipped)", True)
        print("       cargo not found; the router's own client was not exercised")
        return

    completed = subprocess.run(
        [
            "cargo", "test", "--offline", "-p", "hypellm-net",
            "--test", "verifier_acceptance", "--", "--ignored",
        ],
        cwd=REPO,
        env={**os.environ, **environment},
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    output = completed.stdout.decode("utf-8", "replace")
    check("the router's own VerifierClient agrees with the verifier", completed.returncode == 0)
    if completed.returncode != 0:
        print(output)
    else:
        for line in output.splitlines():
            if line.startswith("test ") or line.startswith("test result:"):
                print(f"       {line}")


def main() -> int:
    parser = argparse.ArgumentParser(description="HypeLLM identity verifier acceptance")
    parser.add_argument(
        "--no-cargo",
        action="store_true",
        help="check the wire only; do not run the router's client",
    )
    arguments = parser.parse_args()

    if shutil.which("openssl") is None:
        print("acceptance: openssl is required", file=sys.stderr)
        return 1

    print("acceptance: the router's protocol against the real verifier")

    with tempfile.TemporaryDirectory(prefix="hypellm-verifier-acceptance-") as workspace:
        fixtures = Fixtures(workspace)

        config_path = os.path.join(workspace, "verifier.json")
        with open(config_path, "w", encoding="utf-8") as handle:
            json.dump(
                {
                    "issuer": ISSUER,
                    "client_id": CLIENT_ID,
                    "jwks_uri": f"https://localhost:{fixtures.port}/certs",
                    "token_endpoint": "https://oauth2.googleapis.com/token",
                    "redirect_uri": REDIRECT_URI,
                },
                handle,
            )

        socket_path = os.path.join(workspace, "verify.sock")
        process = subprocess.Popen(
            [
                sys.executable,
                os.path.join(HERE, "hypellm-verifier"),
                "--config", config_path,
                "--socket", socket_path,
                "--log", "warning",
            ],
            # The local key-set server's certificate, and nothing else. The
            # verifier's TLS verification is fully on; it is simply told about a
            # certificate authority that exists for the length of this run.
            env={**os.environ, "SSL_CERT_FILE": fixtures.certificate},
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )

        try:
            for _ in range(200):
                if os.path.exists(socket_path):
                    break
                if process.poll() is not None:
                    print("the verifier exited before it listened:", file=sys.stderr)
                    print(process.communicate()[1].decode("utf-8", "replace"), file=sys.stderr)
                    return 1
                time.sleep(0.05)
            else:
                print("the verifier never created its socket", file=sys.stderr)
                return 1

            environment = wire_layer(socket_path, fixtures)
            if not arguments.no_cargo:
                cargo_layer(environment)
        finally:
            process.terminate()
            with contextlib.suppress(subprocess.TimeoutExpired):
                process.wait(timeout=5)
            if process.poll() is None:
                process.kill()
            fixtures.server.shutdown()

    print()
    if failed:
        print(f"{len(passed)} passed, {len(failed)} FAILED")
        return 1
    print(f"{len(passed)} passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
